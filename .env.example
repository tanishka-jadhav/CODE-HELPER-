# ==========================================
# NVIDIA NIM API Configuration
# ==========================================
# Get your key from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models specified by the Student Guide
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# ==========================================
# Pinecone Vector Database Configuration
# ==========================================
# Get your key from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=code-helper
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ==========================================
# System / Environment Settings
# ==========================================
# Enforces UTF-8 encoding on Windows to prevent UnicodeDecodeError
PYTHONUTF8=1
